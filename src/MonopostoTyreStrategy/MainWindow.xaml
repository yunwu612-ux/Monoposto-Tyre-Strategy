<Window x:Class="MonopostoTyreStrategy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monoposto Tyre Strategy V1.1" Height="900" Width="1440"
        MinHeight="700" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MONOPOSTO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="TYRE STRATEGY" FontSize="30" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                <TextBlock Text="轮胎消耗 · 进站规划 · 比赛时间估算" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="520">
                <Button Content="计算策略" Background="{StaticResource AccentBrush}" Click="Calculate_Click" Padding="18,11" MinHeight="42" ToolTip="根据当前参数重新计算策略"/>
                <Button Content="保存配置" Click="Save_Click" MinHeight="42" ToolTip="将当前参数保存为 JSON"/>
                <Button Content="载入配置" Click="Load_Click" MinHeight="42" ToolTip="载入之前保存的 JSON 配置"/>
                <Button Content="导出报告" Click="Export_Click" MinHeight="42" ToolTip="导出当前策略比较报告"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="比赛设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="F1 赛道库（2026 赛季）" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="CircuitBox" DisplayMemberPath="DisplayName" SelectionChanged="CircuitBox_SelectionChanged" ToolTip="选择赛道后自动填入赛道长度和 F1 标准比赛圈数"/>
                            <TextBlock x:Name="CircuitLengthText" Text="赛道长度：自定义" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="RaceDistanceText" Text="当前比赛距离估算：—" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <TextBlock Text="赛道 / 备注名称" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="TrackNameBox" Text="自定义赛道"/>
                            <TextBlock Text="比赛总圈数" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="RaceLapsBox" Text="35" TextChanged="RaceLapsBox_TextChanged"/>
                            <TextBlock Text="基准单圈时间（秒）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="BaseLapBox" Text="90"/>
                            <TextBlock Text="单次进站损失（秒）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="PitLossBox" Text="22"/>
                            <TextBlock Text="起始轮胎" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="StartingCompoundBox" SelectedIndex="1">
                                <ComboBoxItem Content="软胎"/>
                                <ComboBoxItem Content="中胎"/>
                                <ComboBoxItem Content="硬胎"/>
                            </ComboBox>
                            <TextBlock Text="磨损警戒线（%）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="TargetWearBox" Text="80"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="轮胎参数" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="软胎：每圈磨损（%）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="SoftWearBox" Text="13"/>
                            <TextBlock Text="软胎：单圈速度差（秒）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="SoftPaceBox" Text="-0.45"/>
                            <TextBlock Text="中胎：每圈磨损（%）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="MediumWearBox" Text="9"/>
                            <TextBlock Text="中胎：单圈速度差（秒）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="MediumPaceBox" Text="0"/>
                            <TextBlock Text="硬胎：每圈磨损（%）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="HardWearBox" Text="6"/>
                            <TextBlock Text="硬胎：单圈速度差（秒）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="HardPaceBox" Text="0.55"/>
                            <TextBlock Text="速度差说明：负数代表更快，正数代表更慢。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A2027" CornerRadius="10" Padding="13">
                        <TextBlock Text="提示：以上默认值仅用于演示。请根据 Monoposto 实际比赛数据调整，才能得到更可靠的策略。" TextWrapping="Wrap" Foreground="#FFD1D1" FontSize="12"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="推荐策略" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="RecommendedStrategyText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="预计总用时" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="RecommendedTimeText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="预计进站次数" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="RecommendedStopsText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="轮胎磨损预测曲线（估算）" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Canvas x:Name="WearChart" Grid.Row="1" ClipToBounds="True" Background="#111722" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="策略比较" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="按预计总用时从快到慢排序" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="1" IsReadOnly="True" AlternationCount="2" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="策略" Binding="{Binding StrategyName}" Width="90"/>
                                <DataGridTextColumn Header="预计总用时" Binding="{Binding TotalTimeText}" Width="130"/>
                                <DataGridTextColumn Header="进站次数" Binding="{Binding Stops}" Width="90"/>
                                <DataGridTextColumn Header="分段方案" Binding="{Binding Stints}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="V1.1 · 内置 2026 F1 赛道长度 · 本地计算，不读取游戏内部数据 · 结果为估算值，请用实测圈速校准" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,12,0,0"/>
    </Grid>
</Window>
